<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/main_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/main_hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/main_retry"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/main_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_live" />

        <Button
            android:id="@+id/main_messages"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/messages_title" />

        <LinearLayout
            android:id="@+id/perm_notify"
            style="@style/Doorbell.Card"
            android:visibility="gone">

            <TextView
                style="@style/Doorbell.CardText"
                android:text="@string/perm_notify" />

            <Button
                android:id="@+id/perm_notify_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/perm_fullscreen"
            style="@style/Doorbell.Card"
            android:visibility="gone">

            <TextView
                style="@style/Doorbell.CardText"
                android:text="@string/perm_fullscreen" />

            <Button
                android:id="@+id/perm_fullscreen_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/perm_battery"
            style="@style/Doorbell.Card"
            android:visibility="gone">

            <TextView
                style="@style/Doorbell.CardText"
                android:text="@string/perm_battery" />

            <Button
                android:id="@+id/perm_battery_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allow" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
