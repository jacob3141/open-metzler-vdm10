# Leave empty to run the admin interface without a password
HUB_ADMIN_PASSWORD=
# Name of the existing Docker network the container joins (docker network ls)
HUB_NETWORK=
HUB_IP=
# Address and port of doorbelld
HUB_DOORBELL=doorbell.home.arpa:8080
HUB_RING_TIMEOUT=30
HUB_RECORD_SECONDS=30
# Announce the hub by mDNS as _doorbell-hub._tcp, so the Android app finds it (off to disable)
HUB_MDNS=on
HUB_MDNS_NAME=Doorbell hub
